# ─── Core ────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# App Role: api | worker | all (default: all)
# api    = REST + WebSocket only   (multi-instance, behind LB)
# worker = Cronjobs + seed only    (single-instance)
# all    = Both API + Worker       (dev / single-server)
APP_ROLE=all

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql://vibemusic:vibemusic_dev_2026@localhost:5432/vibemusic

# ─── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Auth ────────────────────────────────────────
JWT_SECRET=vibemusic_jwt_secret_dev_2026_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=vibemusic_refresh_secret_dev_2026_change_in_production
JWT_REFRESH_EXPIRATION=7d

# ─── AI (OpenRouter / OpenAI compatible) ─────────────
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your_openrouter_api_key_here
AI_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# ─── CORS ────────────────────────────────────────────
# Comma-separated list of allowed origins for production
# Leave empty or '*' for development
CORS_ORIGINS=

# ─── Google OAuth (optional) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Apple Sign-In (optional) ───────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ─── Encryption ─────────────────────────────────────
ENCRYPT_SECRET=vibemusic_encrypt_secret_dev